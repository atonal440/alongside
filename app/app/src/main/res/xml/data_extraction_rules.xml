<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the access token out of cloud backups and device transfers (API 31+). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="alongside_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="alongside_settings.xml" />
    </device-transfer>
</data-extraction-rules>
